MARKER_COLORS: list[str]
AUDIO_TRANSITION_TYPES: list[str]
"""The ``transition_type`` of each audio transition: ``"tellers.ai.audio-<name>"``."""

Ease = Literal["linear", "hold", "easeIn", "easeOut", "easeInOut"]

class Keyframe(TypedDict, total=False):
    t: Required[float]
    """Seconds from the start of the clip on the timeline."""
    v: Required[float]
    ease: Ease

class Keyframes(TypedDict):
    keyframes: list[Keyframe]

Animatable = Union[float, Keyframes]
EffectParameter = Union[Animatable, str, bool, list[Any]]

class TellersEffect(TypedDict):
    """A player effect: `Effect.1` with `metadata["tellers.ai"].parameters`."""
    effect_name: str
    """Bare name, e.g. "Blur"; stored as "tellers.ai.Blur" (a "tellers.ai." prefix is accepted on input)."""
    name: Optional[str]
    enabled: bool
    parameters: dict[str, EffectParameter]

class TellersEffectInput(TypedDict, total=False):
    effect_name: Required[str]
    name: Optional[str]
    enabled: Optional[bool]
    parameters: Optional[dict[str, EffectParameter]]

class EffectParameterSpec(TypedDict, total=False):
    name: Required[str]
    kind: Required[Literal["animatable", "color", "string", "choice", "bool", "points", "regions", "follow", "attach", "detect"]]
    options: list[str]

# The `follow` parameter of a Transform (an auto-tracking zoom recipe), with
# the player's `followTransform` option names; left-out settings take its defaults.
# Where a followed subject was chosen: `t` clip seconds, (`x`, `y`) in clip
# space before crop ((0, 0) the clip's center, ±0.5 its edges).
class FollowPick(TypedDict):
    t: float
    x: float
    y: float

# How a detected region looks; left out, the player's defaults. How well
# subjects are found (fps, width, models, thresholds) is the player's
# `detection` option, not the timeline's; `sanitize` drops those keys.
class FollowDetect(TypedDict, total=False):
    padX: float
    padY: float

# A follow needs `region`, or both `target` and `pick` (then the player
# detects and resolves it, see `unresolved_follows`).
class Follow(TypedDict, total=False):
    region: dict[str, Any]
    pick: FollowPick
    detect: FollowDetect
    target: str
    """"faces", a group ("people", "animals", "vehicles") or one COCO category name, e.g. "dog"."""
    fill: float
    aspect: float
    minZoom: float
    maxZoom: float
    deadZone: float
    zoomDeadZone: float
    panSmoothing: float
    zoomSmoothing: float
    anchorX: float
    anchorY: float
    hold: float

# The `attach` parameter of a Transform: keeps the clip on a subject detected
# in the clip of another video track (`track`: its name, id or timeline id).
# Needs `region`, or `target` (then the player detects and resolves it, see
# `unresolved_attaches`); `region` and, with `hide`, `opacity` are written on
# resolution.
class Attach(TypedDict, total=False):
    track: Required[str]
    target: str
    pick: FollowPick
    """This clip's seconds and frame coordinates."""
    detect: FollowDetect
    anchorX: float
    anchorY: float
    smoothing: float
    hide: bool
    opacity: Animatable
    region: dict[str, Any]

# The `detect` parameter of a filter or a Mask: what the player detects on load
# to fill a filter's `regions` or a Mask's shape. The FollowDetect options sit
# beside `target`.
class EffectDetect(FollowDetect, total=False):
    target: Required[str]
    track: str
    """Detect in the clip of this video track (name, id or timeline id) playing alongside, instead of this clip's media."""
    pick: Union[FollowPick, list[FollowPick]]
    """One point, or several (a filter covers each subject found; a Mask the first)."""
    shape: Literal["rectangle", "ellipse", "outline"]

# An effect naming another track; `matches` are the ids of the video tracks it
# names (by name or timeline id, never its own track): empty, it does nothing.
class TrackReference(TypedDict):
    owner_id: Optional[str]
    track_index: int
    item_index: Optional[int]
    effect_index: int
    effect_name: str
    enabled: bool
    kind: Literal["track_matte", "attach", "detect"]
    track: str
    matches: list[Optional[str]]

class ItemDetect(TypedDict):
    item_id: str
    effect_index: int
    effect_name: str
    detect: EffectDetect
    resolved: bool

# A clip's speed: `speed` is a number (0 for a freeze frame, negative plays
# backwards) or keyframes.
class ClipSpeed(TypedDict):
    speed: Union[float, dict[str, Any]]
    preserve_pitch: bool

# A clip group: `parameters` maps x, y, scale, scaleX, scaleY, rotation,
# opacity, pivotX, pivotY to a number or {"keyframes": [...]}.
class ClipGroup(TypedDict):
    id: str
    parameters: dict[str, Any]

class ClipGroupTransform(TypedDict):
    x: float
    y: float
    scale_x: float
    scale_y: float
    rotation: float
    opacity: float
    pivot_x: float
    pivot_y: float

class TellersEffectSpec(TypedDict):
    effect_name: str
    target: Literal["video", "audio", "text", "time"]
    parameters: list[EffectParameterSpec]

