                  "$ref": "#/definitions/TimeRange"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "metadata": {
              "default": null
            },
            "name": {
              "type": [
                "string",
                "null"
              ],
              "default": null
            },
            "target_url": {
              "type": "string",
              "default": ""
            }
          },
          "required": [
            "OTIO_SCHEMA"
          ]
        },
        {
          "type": "object",
          "properties": {
            "OTIO_SCHEMA": {
              "type": "string",
              "enum": [
                "GeneratorReference.1"
