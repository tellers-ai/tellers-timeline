    "MediaReference": {
      "oneOf": [
        {
          "description": "OTIO's `MissingReference` is accepted as an alias and read as an\nexternal reference with an empty `target_url`.\n\nProducers outside our control emit it: the OTIO AAF adapter answers\nevery SourceMob that records no locator URL with a `MissingReference`,\nso importing an Avid sequence used to fail here — `unknown variant\nMissingReference.1` — and take down the whole project load, even for\nclips whose media we had resolved.\n\nIt is an alias rather than a third variant because \"no media yet\" is\nalready what an empty `target_url` means throughout the pipeline\n(`clear_target_urls` empties the field on every project we serve), and\nbecause a distinct variant would force a meaning at each of the\nmatches on this enum for no behavioural gain. It re-serializes as\n`ExternalReference.1`.",
          "type": "object",
          "properties": {
            "OTIO_SCHEMA": {
              "type": "string",
              "enum": [
                "ExternalReference.1"
              ]
            },
            "available_image_bounds": {
              "default": null
            },
            "available_range": {
