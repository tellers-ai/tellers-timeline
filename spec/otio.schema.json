        "Audio",
        "Other"
      ]
    },
    "Transition": {
      "description": "An OTIO `Transition.1` sitting between two neighbouring track items.\n\nA transition takes no track time: `in_offset` says how far it reaches back\ninto the item before it and `out_offset` how far it reaches into the item\nafter it. The neighbours' `source_range`s do not include that overlap, so a\nrenderer has to read extra media handles past each cut. `transition_type`\nis `SMPTE_Dissolve` for a standard dissolve; NLE-specific effects (e.g.\nDaVinci Resolve Fusion transitions) export as `Custom_Transition` with the\ndetails under `metadata`.",
      "type": "object",
      "properties": {
        "OTIO_SCHEMA": {
          "type": "string",
          "default": "Transition.1"
        },
        "enabled": {
          "description": "OTIO `enabled`; absent means enabled. The player skips a transition\nwhose `enabled` is `false` and plays a hard cut.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "in_offset": {
          "allOf": [
