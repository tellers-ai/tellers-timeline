    "CompositeStack": {
      "description": "A `Stack` nested inside a track: a composite clip, drawn as one clip made\nof its own tracks (the player's `CompositeStack`).\n\nIts length is `source_range.duration` when a source range is set, otherwise\nthe length of its longest child track. `source_range.start_time` is the\noffset into the child tracks where the composite starts playing.\n\nThe player draws one level of nesting: a `Stack` inside a composite's\ntrack is skipped. This library loads and edits composites at any depth.",
      "type": "object",
      "properties": {
        "OTIO_SCHEMA": {
          "type": "string",
          "default": "Stack.1"
        },
        "children": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/definitions/Track"
          }
        },
        "effects": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Effect"
          }
        },
        "enabled": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "markers": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Marker"
          }
        },
        "metadata": {
          "default": null
        },
        "name": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "source_range": {
          "anyOf": [
