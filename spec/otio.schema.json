    "Transition": {
      "description": "An OTIO `Transition.1` sitting between two neighbouring track items.\n\nA transition takes no track time: `in_offset` says how far it reaches back into the item before it and `out_offset` how far it reaches into the item after it. The neighbours' `source_range`s do not include that overlap, so a renderer has to read extra media handles past each cut. `transition_type` is `SMPTE_Dissolve` for a standard dissolve; NLE-specific effects (e.g. DaVinci Resolve Fusion transitions) export as `Custom_Transition` with the details under `metadata`.",
      "type": "object",
      "properties": {
        "OTIO_SCHEMA": {
          "default": "Transition.1",
          "type": "string"
        },
        "in_offset": {
          "default": {
            "OTIO_SCHEMA": "RationalTime.1",
            "rate": 1.0,
            "value": 0.0
          },
          "allOf": [
            {
              "$ref": "#/definitions/RationalTime"
            }
          ]
        },
        "metadata": {
          "default": null
        },
        "name": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "out_offset": {
          "default": {
            "OTIO_SCHEMA": "RationalTime.1",
            "rate": 1.0,
            "value": 0.0
          },
          "allOf": [
            {
              "$ref": "#/definitions/RationalTime"
            }
          ]
        },
        "transition_type": {
          "default": "SMPTE_Dissolve",
          "type": "string"
        }
      }
    }
